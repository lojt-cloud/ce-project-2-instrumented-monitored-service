{
  "widgets": [
    {
      "type": "metric",
      "x": 0, "y": 0, "width": 6, "height": 6,
      "properties": {
        "metrics": [["AuthService", "api_latency_ms", {"stat": "SampleCount", "label": "Requests"}]],
        "view": "singleValue",
        "region": "${AWS_REGION}",
        "title": "Request rate (5 min)",
        "period": 300
      }
    },
    {
      "type": "metric",
      "x": 6, "y": 0, "width": 6, "height": 6,
      "properties": {
        "metrics": [
          ["AuthService", "login_failed_total", {"id": "m1", "visible": false}],
          ["AuthService", "login_blocked_total", {"id": "m2", "visible": false}],
          ["AuthService", "login_success_total", {"id": "m3", "visible": false}],
          [{"expression": "(m1+m2)/(m1+m2+m3)*100", "label": "Error rate %", "id": "e1"}]
        ],
        "view": "singleValue",
        "region": "${AWS_REGION}",
        "title": "Error rate %",
        "period": 300
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 0, "width": 6, "height": 6,
      "properties": {
        "metrics": [["AuthService", "api_latency_ms", {"stat": "p95", "label": "P95 latency"}]],
        "view": "singleValue",
        "region": "${AWS_REGION}",
        "title": "P95 latency (ms)",
        "period": 300
      }
    },
    {
      "type": "metric",
      "x": 18, "y": 0, "width": 6, "height": 6,
      "properties": {
        "metrics": [["CWAgent", "cpu_usage_active", {"stat": "Average", "label": "CPU %"}]],
        "view": "singleValue",
        "region": "${AWS_REGION}",
        "title": "CPU utilization",
        "period": 300
      }
    },
    {
      "type": "metric",
      "x": 0, "y": 6, "width": 12, "height": 6,
      "properties": {
        "metrics": [
          ["AuthService", "login_success_total", {"stat": "Sum", "label": "Success"}],
          ["AuthService", "login_failed_total", {"stat": "Sum", "label": "Failed"}],
          ["AuthService", "login_blocked_total", {"stat": "Sum", "label": "Blocked (locked)"}],
          ["AuthService", "account_lockouts_total", {"stat": "Sum", "label": "New lockouts"}]
        ],
        "view": "timeSeries",
        "region": "${AWS_REGION}",
        "title": "Login outcomes",
        "period": 60,
        "stacked": false
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 6, "width": 12, "height": 6,
      "properties": {
        "metrics": [
          ["AuthService", "api_latency_ms", {"stat": "Average", "label": "Avg latency"}],
          ["AuthService", "api_latency_ms", {"stat": "p95", "label": "P95 latency"}]
        ],
        "view": "timeSeries",
        "region": "${AWS_REGION}",
        "title": "Latency",
        "period": 60
      }
    },
    {
      "type": "metric",
      "x": 0, "y": 12, "width": 12, "height": 6,
      "properties": {
        "metrics": [
          ["AuthService", "login_failed_total", {"id": "m1", "visible": false}],
          ["AuthService", "login_blocked_total", {"id": "m2", "visible": false}],
          ["AuthService", "login_success_total", {"id": "m3", "visible": false}],
          [{"expression": "(m1+m2)/(m1+m2+m3)*100", "label": "Error rate %", "id": "e1"}]
        ],
        "view": "timeSeries",
        "region": "${AWS_REGION}",
        "title": "Error rate % over time",
        "period": 60
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 12, "width": 12, "height": 6,
      "properties": {
        "metrics": [["AuthService", "authenticated_requests_total", {"stat": "Sum", "label": "Authenticated requests"}]],
        "view": "timeSeries",
        "region": "${AWS_REGION}",
        "title": "Authenticated requests",
        "period": 60
      }
    },
    {
      "type": "metric",
      "x": 0, "y": 18, "width": 24, "height": 6,
      "properties": {
        "metrics": [
          ["CWAgent", "cpu_usage_active", {"stat": "Average", "label": "CPU %"}],
          ["CWAgent", "mem_used_percent", {"stat": "Average", "label": "Memory %"}],
          ["CWAgent", "disk_used_percent", {"stat": "Average", "label": "Disk %"}]
        ],
        "view": "timeSeries",
        "region": "${AWS_REGION}",
        "title": "Saturation (CPU / memory / disk)",
        "period": 60
      }
    }
  ]
}