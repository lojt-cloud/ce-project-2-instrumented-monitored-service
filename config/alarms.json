  },
  {
    "AlarmName": "AuthService-Latency-Critical",
    "AlarmDescription": "P95 latency exceeds 1 second, users are noticing.",
    "Namespace": "AuthService",
    "MetricName": "api_latency_ms",
    "ExtendedStatistic": "p95",
    "Period": 60,
    "EvaluationPeriods": 1,
    "DatapointsToAlarm": 1,
